# Copy to deploy/.env.prod and fill in real values (deploy/.env.prod is gitignored).
# generate random values:
#   openssl rand -base64 48   # ADMIN_AUTH_SECRET
#   openssl rand -base64 32   # CONFIG_MASTER_KEY
#   openssl rand -hex 16      # PG_PASSWORD / REDIS_PASSWORD

# --- PostgreSQL / Redis (host docker compose) ---
PG_DATABASE=dragz
PG_USER=dragz
PG_PASSWORD=
REDIS_PASSWORD=
# Node private IP; binds Postgres/Redis to the internal network only.
DB_BIND_IP=127.0.0.1

# --- Application secrets ---
# admin-api and jobs-runner JWT signing secret (>= 32 chars).
ADMIN_AUTH_SECRET=
# AES key (base64, 32 bytes). MUST be identical across admin-api and
# jobs-runner, otherwise stored secrets cannot be decrypted.
CONFIG_MASTER_KEY=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- Container registry ---
REGISTRY_SERVER=hub.cszqq.top
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
APP_TAG=v1.0.1

# --- Alibaba Cloud DNS (cert-manager DNS-01) ---
# RAM user needs DNS (AliyunDNSFullAccess or scoped) permission for the zone.
ALIDNS_ACCESS_KEY_ID=
ALIDNS_ACCESS_KEY_SECRET=
