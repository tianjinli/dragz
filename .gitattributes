# Normalise line endings: LF in the repository, LF in the working tree.
# Shell scripts and SQL must stay LF or they break inside Linux containers.
* text=auto eol=lf

*.sh   text eol=lf
*.sql  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Windows-only helpers keep their native line endings.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary assets: never diff, never convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
